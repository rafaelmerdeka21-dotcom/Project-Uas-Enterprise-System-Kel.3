##############################################
#  .env.example — Template Environment Variables
#  SALIN file ini menjadi .env dan isi nilainya.
#  File ini AMAN di-commit — tidak ada nilai sensitif.
##############################################

APP_NAME="EMS Dagang"
APP_ENV=production
APP_KEY=                          # Jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────
# Untuk Vercel: gunakan PlanetScale, Railway, Neon, atau Supabase
# Contoh PlanetScale (MySQL): mysql://user:pass@host/db?ssl={"rejectUnauthorized":true}
DB_CONNECTION=mysql
DB_HOST=                          # Host database cloud Anda
DB_PORT=3306
DB_DATABASE=                      # Nama database
DB_USERNAME=                      # Username database
DB_PASSWORD=                      # Password database (JANGAN isi di sini!)

# ── Session & Cache ───────────────────────────────────────────
# Untuk serverless, gunakan 'cookie' atau 'database'
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@ems-dagang.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (opsional, untuk upload file) ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
